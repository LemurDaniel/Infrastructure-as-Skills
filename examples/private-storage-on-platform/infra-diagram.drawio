          <mxGeometry x="20" y="650" width="500" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;invoicing &amp;#8212; Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
