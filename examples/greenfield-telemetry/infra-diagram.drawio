        <mxCell id="subtitle" value="No service is reachable from the internet: access runs over private endpoints. Sign-in is by company identity, no keys." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#605E5C;" vertex="1" parent="1">
